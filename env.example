# Get these from https://my.telegram.org/apps (log in with the phone number
# you plan to use for downloading — NOT a bot token, a real user account)
API_ID=123456
API_HASH=your_api_hash_here

# Port the backend listens on. Most hosts (Render/Railway) inject this
# automatically — you usually don't need to set it yourself.
PORT=3001

# Comma-separated list of origins allowed to call this backend.
# Set this to the URL where your frontend (index.html) is hosted —
# e.g. https://yourname.github.io
# Do NOT leave this as * once you share the app or deploy it publicly:
# a wildcard lets ANY website on the internet call your backend and
# attempt to log in with someone's phone number through it.
ALLOWED_ORIGIN=https://yourname.github.io

# Optional. If set, session status/metadata is stored in Redis instead of
# an in-memory Map — recommended for production so logins survive a restart
# and are visible across multiple server instances behind a load balancer.
# Requires `npm install ioredis`. Leave unset for local/single-instance use.
# REDIS_URL=redis://default:password@your-redis-host:6379
