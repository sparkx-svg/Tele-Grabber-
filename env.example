# Get these from https://my.telegram.org/apps (log in with the phone number
# you plan to use for downloading — NOT a bot token, a real user account)
API_ID=123456
API_HASH=your_api_hash_here

# Port the backend listens on. Most hosts (Render/Railway) inject this
# automatically — you usually don't need to set it yourself.
PORT=3001

# Comma-separated list of origins allowed to call this backend.
# Set this to the URL where your frontend (index.html) is hosted.
# Use * only while testing locally.
ALLOWED_ORIGIN=*
